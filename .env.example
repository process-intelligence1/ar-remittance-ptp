# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is listed in .gitignore, so it is never uploaded to GitHub.

ENVIRONMENT=local

# PostgreSQL on your laptop: user ar_app, database ar_demo (created on Day 1)
DATABASE_URL=postgresql+psycopg://ar_app:YOUR_AR_APP_PASSWORD@localhost:5432/ar_demo

# Demo business date (all rules use this instead of today's real date)
BUSINESS_DATE=2026-10-28

# Gmail (used from Day 3). Files live OUTSIDE the project folder.
GMAIL_ADDRESS=processintelligence1@gmail.com
GMAIL_CLIENT_SECRET_FILE=D:\Finance\Secret\YOUR_CLIENT_SECRET_FILE.json
GMAIL_TOKEN_FILE=D:\Finance\Secret\gmail_token.json

# Every outgoing e-mail is redirected here (demo safety switch)
OUTBOUND_MODE=redirect
OUTBOUND_REDIRECT_TO=processintelligence1@gmail.com

# Where the app stores received e-mails and attachments on your laptop
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=D:\Finance\AR_Remittance\data\runtime

# OCR
OCR_ENGINE=tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Front-end address allowed to call the API
CORS_ORIGINS=http://localhost:5173
